# Unity – na bazie https://github.com/github/gitignore/blob/main/Unity.gitignore
# Plik leży w katalogu projektu Unity (SYGNET_Unity/), więc ścieżki z "/" są względem niego.

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender
*.blend1
*.blend1.meta

# Memory Profiler / Recorder (duże i mogą zawierać wrażliwe dane)
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerowany plugin JetBrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Cache IDE / Gradle
.vs/
.idea/
.vscode/
.gradle/

# Pliki rozwiązania i projektów generowane przez Unity
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Raporty awarii
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Buildy
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/

# Test Runner
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Visual Scripting
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# --- SYGNET ---
# Zrzuty ekranu z MCP for Unity (manage_camera screenshot)
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta

# Keystore do podpisu release – nigdy do repo
*.keystore
*.jks

# System
.DS_Store
Thumbs.db
desktop.ini
